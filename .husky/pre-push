#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"

site_commit=
while read -r local_ref local_oid remote_ref remote_oid; do
    if [ "$1" = origin ] && [ "$remote_ref" = refs/heads/main ] &&
        [ "$local_ref" != "(delete)" ] && [ "$local_oid" != "$remote_oid" ]; then
        site_commit=$local_oid
    fi
done

echo "pre-push: cargo check ..."
cargo check --quiet

if [ -n "$site_commit" ]; then
    exec scripts/push-site-source.sh "$site_commit"
fi
